@page
@model MenuModel
@{
    ViewData["Title"] = "La Carte du Restaurant";
}

<div class="mb-4 text-center">
    <span class="badge bg-warning text-dark px-3 py-1 rounded-pill fw-semibold mb-2">Carte & Menus</span>
    <h1 class="brand-font fw-bold">Notre Carte Gastronomique</h1>
    <p class="text-muted mx-auto" style="max-width: 600px;">
        Découvrez notre sélection de mets préparés minute avec des produits frais du terroir.
    </p>
</div>

<!-- Filtres de recherche et catégories -->
<div class="card card-custom p-3 mb-4">
    <form method="get" class="row g-3 align-items-center">
        <div class="col-md-6 col-lg-5">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0">
                    <i class="bi bi-search text-muted"></i>
                </span>
                <input type="text" name="SearchTerm" value="@Model.SearchTerm" class="form-control border-start-0" 
                       placeholder="Rechercher un plat, un ingrédient..." />
                @if (!string.IsNullOrEmpty(Model.SearchTerm))
                {
                    <a asp-page="/Menu" class="btn btn-outline-secondary" title="Effacer la recherche">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>
        </div>

        <div class="col-md-4 col-lg-4">
            <select name="SelectedCategoryId" class="form-select" onchange="this.form.submit()">
                <option value="">Toutes les catégories (@Model.MenuItems.Count)</option>
                @foreach (var cat in Model.Categories)
                {
                    <option value="@cat.Id" selected="@(Model.SelectedCategoryId == cat.Id)">@cat.Name</option>
                }
            </select>
        </div>

        <div class="col-md-2 col-lg-3 d-flex gap-2">
            <button type="submit" class="btn btn-gold flex-grow-1">Filtrer</button>
            <a asp-page="/Menu" class="btn btn-outline-secondary" title="Réinitialiser">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        </div>
    </form>
</div>

<!-- Liste des plats -->
@if (!Model.MenuItems.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-search display-3 text-muted mb-3"></i>
        <h4 class="fw-bold">Aucun plat trouvé</h4>
        <p class="text-muted">Essayez un autre mot-clé ou sélectionnez une autre catégorie.</p>
        <a asp-page="/Menu" class="btn btn-gold mt-2">Réinitialiser les filtres</a>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var item in Model.MenuItems)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card card-custom menu-item-card h-100">
                    <div class="position-relative">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" class="menu-item-img" alt="@item.Name" loading="lazy" />
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center text-muted" style="height: 200px;">
                                <i class="bi bi-card-image display-4"></i>
                            </div>
                        }

                        @if (!item.IsAvailable)
                        {
                            <span class="badge bg-danger position-absolute top-0 end-0 m-3 shadow">Épuisé</span>
                        }
                        else
                        {
                            <span class="badge bg-success position-absolute top-0 end-0 m-3 shadow">Disponible</span>
                        }
                    </div>

                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-baseline mb-2">
                            <span class="badge bg-light text-secondary border">@item.Category?.Name</span>
                            <span class="price-tag">@item.Price.ToString("C2")</span>
                        </div>

                        <h5 class="card-title fw-bold">@item.Name</h5>
                        <p class="card-text text-muted small flex-grow-1">@item.Description</p>

                        <div class="d-flex justify-content-between align-items-center pt-3 border-top mt-auto">
                            <span class="text-muted small">
                                <i class="bi bi-clock me-1"></i>~@item.PreparationTimeMinutes min
                            </span>
                            <a asp-page="/Reserver" class="btn btn-sm btn-outline-warning">
                                <i class="bi bi-bookmark-check me-1"></i>Réserver une table
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}


@page "{id:int}"
@model restauration.Pages.Admin.Menu.EditModel
@{
    ViewData["Title"] = "Modifier un Plat";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-0">Modifier le Plat</h2>
                <p class="text-muted small">Mettez à jour les informations et tarifs</p>
            </div>
            <a asp-page="./Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Retour à la liste
            </a>
        </div>

        <div class="card card-custom p-4">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <input type="hidden" asp-for="MenuItem.Id" />

                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="MenuItem.Name" class="form-label fw-semibold"></label>
                        <input asp-for="MenuItem.Name" class="form-control" />
                        <span asp-validation-for="MenuItem.Name" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="MenuItem.CategoryId" class="form-label fw-semibold"></label>
                        <select asp-for="MenuItem.CategoryId" asp-items="Model.CategoriesList" class="form-select"></select>
                        <span asp-validation-for="MenuItem.CategoryId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="MenuItem.Price" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <input asp-for="MenuItem.Price" type="number" step="0.10" class="form-control" />
                            <span class="input-group-text">€</span>
                        </div>
                        <span asp-validation-for="MenuItem.Price" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="MenuItem.PreparationTimeMinutes" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <input asp-for="MenuItem.PreparationTimeMinutes" type="number" min="1" class="form-control" />
                            <span class="input-group-text">minutes</span>
                        </div>
                        <span asp-validation-for="MenuItem.PreparationTimeMinutes" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="MenuItem.ImageUrl" class="form-label fw-semibold"></label>
                        <input asp-for="MenuItem.ImageUrl" class="form-control" />
                        <span asp-validation-for="MenuItem.ImageUrl" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="MenuItem.Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="MenuItem.Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="MenuItem.Description" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <div class="form-check form-switch mt-2">
                            <input asp-for="MenuItem.IsAvailable" class="form-check-input" type="checkbox" />
                            <label asp-for="MenuItem.IsAvailable" class="form-check-label fw-semibold">Plat disponible à la vente</label>
                        </div>
                    </div>

                    <div class="col-12 mt-4 text-end">
                        <a asp-page="./Index" class="btn btn-secondary me-2">Annuler</a>
                        <button type="submit" class="btn btn-gold px-4">
                            <i class="bi bi-save me-1"></i>Enregistrer les modifications
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


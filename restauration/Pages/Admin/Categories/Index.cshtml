@page
@model restauration.Pages.Admin.Categories.IndexModel
@{
    ViewData["Title"] = "Gestion des Catégories";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-tag-fill text-primary me-2"></i>Catégories du Menu</h2>
        <p class="text-muted mb-0">Organisez les rubriques de votre carte (Entrées, Plats, Desserts, Boissons...)</p>
    </div>
    <button class="btn btn-gold" data-bs-toggle="modal" data-bs-target="#newCategoryModal">
        <i class="bi bi-plus-circle me-1"></i>Nouvelle Catégorie
    </button>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
    </div>
}

<div class="row g-4">
    @foreach (var cat in Model.Categories)
    {
        <div class="col-md-6 col-lg-3">
            <div class="card card-custom h-100 p-4">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="badge bg-light text-dark border">Ordre: @cat.DisplayOrder</span>
                    <form method="post" asp-page-handler="DeleteCategory" asp-route-id="@cat.Id" class="d-inline"
                          onsubmit="return confirm('Confirmez-vous la suppression de cette catégorie ?');">
                        <button type="submit" class="btn btn-sm btn-link text-danger p-0" title="Supprimer">
                            <i class="bi bi-trash"></i>
                        </button>
                    </form>
                </div>
                <h5 class="fw-bold mt-2 mb-1">@cat.Name</h5>
                <p class="small text-muted flex-grow-1">@(cat.Description ?? "Aucune description")</p>
                <div class="d-flex justify-content-between align-items-center pt-3 border-top mt-auto">
                    <span class="badge bg-primary bg-opacity-10 text-primary fw-semibold">
                        <i class="bi bi-egg me-1"></i>@cat.MenuItems.Count plat(s)
                    </span>
                    <a asp-page="/Admin/Menu/Index" asp-route-CategoryId="@cat.Id" class="btn btn-sm btn-outline-secondary">
                        Voir les plats
                    </a>
                </div>
            </div>
        </div>
    }
</div>

<!-- Modal Nouvelle Catégorie -->
<div class="modal fade" id="newCategoryModal" tabindex="-1" aria-labelledby="newCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="AddCategory">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="newCategoryModalLabel">Ajouter une Catégorie</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label asp-for="NewCategory.Name" class="form-label fw-semibold">Nom de la catégorie</label>
                        <input asp-for="NewCategory.Name" class="form-control" placeholder="ex: Fromages Affinés" required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewCategory.Description" class="form-label fw-semibold">Description</label>
                        <textarea asp-for="NewCategory.Description" class="form-control" rows="2" placeholder="Courte description affichée aux clients"></textarea>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewCategory.DisplayOrder" class="form-label fw-semibold">Ordre d'affichage</label>
                        <input asp-for="NewCategory.DisplayOrder" type="number" min="0" class="form-control" value="@(Model.Categories.Count + 1)" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-gold">Créer la catégorie</button>
                </div>
            </form>
        </div>
    </div>
</div>


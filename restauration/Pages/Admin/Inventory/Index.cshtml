@page
@model restauration.Pages.Admin.Inventory.IndexModel
@{
    ViewData["Title"] = "Gestion des Stocks";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-box-seam-fill text-secondary me-2"></i>Gestion des Stocks & Ingrédients</h2>
        <p class="text-muted mb-0">Suivi des quantités en cuisine, alertes de réapprovisionnement et gestion des pertes</p>
    </div>
    <button class="btn btn-gold" data-bs-toggle="modal" data-bs-target="#addItemModal">
        <i class="bi bi-plus-circle me-1"></i>Nouvel Ingrédient
    </button>
</div>

<!-- Cartes résumées -->
<div class="row g-3 mb-4">
    <div class="col-md-6 col-lg-4">
        <div class="stat-card" style="border-left-color: #6c757d;">
            <div class="stat-icon" style="background-color: rgba(108, 117, 125, 0.15); color: #6c757d;">
                <i class="bi bi-boxes"></i>
            </div>
            <div>
                <div class="stat-label">Total Articles Référencés</div>
                <div class="stat-value">@Model.InventoryItems.Count</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-4">
        <div class="stat-card" style="border-left-color: #dc3545;">
            <div class="stat-icon" style="background-color: rgba(220, 53, 69, 0.12); color: #dc3545;">
                <i class="bi bi-exclamation-triangle"></i>
            </div>
            <div>
                <div class="stat-label">Articles en Rupture / Alerte</div>
                <div class="stat-value text-danger">@Model.InventoryItems.Count(i => i.IsLowStock)</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-4">
        <div class="stat-card" style="border-left-color: #198754;">
            <div class="stat-icon" style="background-color: rgba(25, 135, 84, 0.12); color: #198754;">
                <i class="bi bi-check-circle"></i>
            </div>
            <div>
                <div class="stat-label">Articles en Stock Optimal</div>
                <div class="stat-value text-success">@Model.InventoryItems.Count(i => !i.IsLowStock)</div>
            </div>
        </div>
    </div>
</div>

<!-- Tableau des stocks -->
<div class="card card-custom p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Ingrédient / Produit</th>
                    <th>Quantité Actuelle</th>
                    <th>Seuil Alerte</th>
                    <th>État du Stock</th>
                    <th>Dernier Réappro.</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.InventoryItems)
                {
                    <tr class="@(item.IsLowStock ? "table-danger bg-opacity-25" : "")">
                        <td class="fw-bold">@item.Name</td>
                        <td class="fs-6 fw-semibold">
                            @item.Quantity.ToString("0.##") <span class="text-muted small">@item.Unit</span>
                        </td>
                        <td class="text-muted">
                            @item.MinAlertQuantity.ToString("0.##") @item.Unit
                        </td>
                        <td>
                            @if (item.IsLowStock)
                            {
                                <span class="badge bg-danger">
                                    <i class="bi bi-exclamation-octagon me-1"></i>Stock Faible
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success">
                                    <i class="bi bi-check-lg me-1"></i>Suffisant
                                </span>
                            }
                        </td>
                        <td class="small text-muted">
                            @item.LastRestocked.ToString("dd/MM/yyyy HH:mm")
                        </td>
                        <td class="text-end">
                            <form method="post" asp-page-handler="Restock" asp-route-id="@item.Id" class="d-inline-flex gap-1 align-items-center">
                                <input type="number" name="addQuantity" min="0.1" step="0.5" value="5" class="form-control form-control-sm text-center" style="width: 70px;" />
                                <button type="submit" class="btn btn-sm btn-outline-success" title="Ajouter au stock">
                                    <i class="bi bi-plus-lg me-1"></i>Réappro
                                </button>
                            </form>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" class="d-inline ms-1"
                                  onsubmit="return confirm('Confirmez-vous la suppression de cet article ?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Supprimer">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Nouvel Article Stock -->
<div class="modal fade" id="addItemModal" tabindex="-1" aria-labelledby="addItemModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="AddItem">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="addItemModalLabel">Nouvel Ingrédient / Article</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label asp-for="NewItem.Name" class="form-label fw-semibold">Nom de l'ingrédient</label>
                        <input asp-for="NewItem.Name" class="form-control" placeholder="ex: Fromage Mozzarella di Bufala" required />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label asp-for="NewItem.Quantity" class="form-label fw-semibold">Quantité initiale</label>
                            <input asp-for="NewItem.Quantity" type="number" step="0.1" min="0" class="form-control" required />
                        </div>
                        <div class="col-6">
                            <label asp-for="NewItem.Unit" class="form-label fw-semibold">Unité</label>
                            <select asp-for="NewItem.Unit" class="form-select">
                                <option value="kg">kg</option>
                                <option value="litres">litres</option>
                                <option value="pièces">pièces</option>
                                <option value="bouteilles">bouteilles</option>
                                <option value="boîtes">boîtes</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewItem.MinAlertQuantity" class="form-label fw-semibold">Seuil d'alerte minimum</label>
                        <input asp-for="NewItem.MinAlertQuantity" type="number" step="0.1" min="0" class="form-control" value="5" required />
                        <small class="text-muted">Une alerte sera affichée sur le tableau de bord dès que le stock descend sous cette limite.</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-gold">Ajouter l'ingrédient</button>
                </div>
            </form>
        </div>
    </div>
</div>


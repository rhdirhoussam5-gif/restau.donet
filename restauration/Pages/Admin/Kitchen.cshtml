@page
@model restauration.Pages.Admin.KitchenModel
@{
    ViewData["Title"] = "Écran Cuisine (KDS)";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-fire text-danger me-2"></i>Écran Cuisine en Direct (KDS)</h2>
        <p class="text-muted mb-0">Affichage plein écran des bons de commande en attente et en cuisson</p>
    </div>
    <div class="d-flex align-items-center gap-3">
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" id="autoRefreshSwitch" checked onchange="toggleAutoRefresh(this.checked)">
            <label class="form-check-label small fw-semibold" for="autoRefreshSwitch">Actualisation auto (15s)</label>
        </div>
        <a asp-page="/Admin/Kitchen" class="btn btn-outline-dark btn-sm">
            <i class="bi bi-arrow-clockwise me-1"></i>Actualiser
        </a>
    </div>
</div>

@if (!Model.KitchenOrders.Any())
{
    <div class="card card-custom p-5 text-center my-4 border-0 shadow-sm">
        <div class="display-1 text-success mb-3">
            <i class="bi bi-check-circle"></i>
        </div>
        <h3 class="fw-bold text-success">Aucune commande en attente !</h3>
        <p class="text-muted lead">Toutes les commandes sont préparées ou servies. La cuisine est à jour.</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var order in Model.KitchenOrders)
        {
            var minutesElapsed = (int)(DateTime.Now - order.CreatedAt).TotalMinutes;
            var isUrgent = minutesElapsed >= 20;
            var isPreparing = order.Status == OrderStatus.EnPreparation;

            <div class="col-md-6 col-xl-4">
                <div class="card card-custom h-100 shadow border @(isUrgent ? "border-danger border-2" : (isPreparing ? "border-primary border-2" : "border-warning border-2"))">
                    <!-- En-tête du bon de commande -->
                    <div class="card-header @(isUrgent ? "bg-danger text-white" : (isPreparing ? "bg-primary text-white" : "bg-warning text-dark")) d-flex justify-content-between align-items-center py-3">
                        <div>
                            <span class="fs-5 fw-bold">@order.OrderNumber</span>
                            @if (order.RestaurantTable != null)
                            {
                                <div class="badge bg-light text-dark fw-bold ms-2">Table @order.RestaurantTable.TableNumber</div>
                            }
                            else
                            {
                                <div class="badge bg-dark text-white ms-2">@order.OrderType</div>
                            }
                        </div>
                        <div class="text-end">
                            <div class="fw-bold small">
                                <i class="bi bi-stopwatch me-1"></i>@minutesElapsed min
                            </div>
                            <span class="badge @(isUrgent ? "bg-dark" : "bg-light text-dark") small">
                                @(isPreparing ? "En Préparation" : "En Attente")
                            </span>
                        </div>
                    </div>

                    <!-- Contenu du bon -->
                    <div class="card-body p-3">
                        @if (!string.IsNullOrEmpty(order.Notes))
                        {
                            <div class="alert alert-warning py-2 px-3 small mb-3">
                                <i class="bi bi-info-circle me-1"></i><strong>Remarque :</strong> @order.Notes
                            </div>
                        }

                        <h6 class="text-uppercase text-muted fw-bold small mb-2 border-bottom pb-1">Plats à préparer</h6>
                        <ul class="list-group list-group-flush mb-3">
                            @foreach (var item in order.OrderItems)
                            {
                                <li class="list-group-item px-0 py-2 d-flex justify-content-between align-items-start border-bottom">
                                    <div>
                                        <span class="fs-5 fw-bold text-dark me-2">@item.Quantity x</span>
                                        <span class="fs-6 fw-semibold">@item.MenuItem?.Name</span>
                                        @if (!string.IsNullOrEmpty(item.Notes))
                                        {
                                            <div class="badge bg-danger bg-opacity-75 text-white mt-1 d-block">
                                                @item.Notes
                                            </div>
                                        }
                                    </div>
                                    <span class="badge bg-light text-muted border small">
                                        ~@item.MenuItem?.PreparationTimeMinutes min
                                    </span>
                                </li>
                            }
                        </ul>
                    </div>

                    <!-- Actions Cuisine -->
                    <div class="card-footer bg-light p-3 border-top d-flex gap-2">
                        @if (!isPreparing)
                        {
                            <form method="post" asp-page-handler="StartPreparation" asp-route-orderId="@order.Id" class="flex-grow-1">
                                <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                                    <i class="bi bi-play-circle me-1"></i>Démarrer la préparation
                                </button>
                            </form>
                        }
                        else
                        {
                            <form method="post" asp-page-handler="MarkReady" asp-route-orderId="@order.Id" class="flex-grow-1">
                                <button type="submit" class="btn btn-success w-100 py-2 fw-semibold fs-6">
                                    <i class="bi bi-check2-circle me-1"></i>Prêt à Servir !
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <script>
        let refreshTimer = setInterval(function() {
            window.location.reload();
        }, 15000);

        function toggleAutoRefresh(enabled) {
            if (enabled) {
                refreshTimer = setInterval(function() {
                    window.location.reload();
                }, 15000);
            } else {
                clearInterval(refreshTimer);
            }
        }
    </script>
}


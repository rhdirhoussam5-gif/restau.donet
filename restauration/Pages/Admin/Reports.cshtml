@page
@model restauration.Pages.Admin.ReportsModel
@{
    ViewData["Title"] = "Statistiques & Rapports";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-graph-up-arrow text-success me-2"></i>Statistiques & Performance</h2>
        <p class="text-muted mb-0">Analyse des ventes, panier moyen et palmarès des spécialités du restaurant</p>
    </div>
    <div class="d-flex gap-2">
        <button onclick="window.print()" class="btn btn-outline-dark">
            <i class="bi bi-printer me-1"></i>Imprimer le rapport
        </button>
    </div>
</div>

<!-- Chiffres Clés -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card" style="border-left-color: #198754;">
            <div class="stat-icon" style="background-color: rgba(25, 135, 84, 0.12); color: #198754;">
                <i class="bi bi-cash"></i>
            </div>
            <div>
                <div class="stat-label">CA du Jour</div>
                <div class="stat-value">@Model.RevenueToday.ToString("C2")</div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="stat-card" style="border-left-color: #0d6efd;">
            <div class="stat-icon" style="background-color: rgba(13, 110, 253, 0.12); color: #0d6efd;">
                <i class="bi bi-calendar-month"></i>
            </div>
            <div>
                <div class="stat-label">CA du Mois en Cours</div>
                <div class="stat-value">@Model.RevenueThisMonth.ToString("C2")</div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="stat-card" style="border-left-color: #ffc107;">
            <div class="stat-icon" style="background-color: rgba(255, 193, 7, 0.18); color: #d39e00;">
                <i class="bi bi-basket2"></i>
            </div>
            <div>
                <div class="stat-label">Panier Moyen / Commande</div>
                <div class="stat-value">@Model.AverageBasket.ToString("C2")</div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="stat-card" style="border-left-color: #6f42c1;">
            <div class="stat-icon" style="background-color: rgba(111, 66, 193, 0.12); color: #6f42c1;">
                <i class="bi bi-receipt"></i>
            </div>
            <div>
                <div class="stat-label">Total Commandes Encaissées</div>
                <div class="stat-value">@Model.TotalPaidOrders</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Top 5 des plats les plus vendus -->
    <div class="col-lg-7">
        <div class="card card-custom p-4 h-100">
            <h5 class="fw-bold mb-3">
                <i class="bi bi-trophy-fill text-warning me-2"></i>Palmarès des Plats les Plus Vendus
            </h5>

            @if (!Model.TopDishes.Any())
            {
                <div class="text-center py-4 text-muted">
                    <p class="mb-0">Aucune vente enregistrée pour le moment.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Plat</th>
                                <th>Catégorie</th>
                                <th class="text-center">Quantité</th>
                                <th class="text-end">CA Généré</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int rank = 1; }
                            @foreach (var dish in Model.TopDishes)
                            {
                                <tr>
                                    <td>
                                        <span class="badge @(rank == 1 ? "bg-warning text-dark" : (rank == 2 ? "bg-secondary" : "bg-light text-dark border")) rounded-pill">
                                            #@rank
                                        </span>
                                    </td>
                                    <td class="fw-bold">@dish.DishName</td>
                                    <td><span class="badge bg-light text-dark border">@dish.CategoryName</span></td>
                                    <td class="text-center fw-bold">@dish.QuantitySold</td>
                                    <td class="text-end fw-bold text-success">@dish.TotalRevenue.ToString("C2")</td>
                                </tr>
                                rank++;
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Répartition du Chiffre d'Affaires par Catégorie -->
    <div class="col-lg-5">
        <div class="card card-custom p-4 h-100">
            <h5 class="fw-bold mb-3">
                <i class="bi bi-pie-chart-fill text-primary me-2"></i>Répartition du CA par Catégorie
            </h5>

            @if (!Model.RevenueByCategory.Any())
            {
                <div class="text-center py-4 text-muted">
                    <p class="mb-0">Données insuffisantes.</p>
                </div>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var item in Model.RevenueByCategory)
                    {
                        var percentage = Model.TotalRevenueAllTime > 0 ? (item.Value / Model.TotalRevenueAllTime) * 100 : 0;
                        <div class="list-group-item px-0 py-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-semibold">@item.Key</span>
                                <span class="fw-bold text-dark">@item.Value.ToString("C2") (@percentage.ToString("0.#")%)</span>
                            </div>
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar bg-warning" role="progressbar" style="width: @percentage.ToString("0")%"></div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>


@page "{id:int}"
@model restauration.Pages.Admin.Orders.DetailsModel
@{
    ViewData["Title"] = "Détails de la Commande " + Model.Order.OrderNumber;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-0">Commande @Model.Order.OrderNumber</h2>
        <p class="text-muted small">Créée le @Model.Order.CreatedAt.ToString("dd/MM/yyyy à HH:mm")</p>
    </div>
    <div class="d-flex gap-2">
        <button onclick="window.print()" class="btn btn-outline-dark">
            <i class="bi bi-printer me-1"></i>Imprimer le ticket
        </button>
        <a asp-page="./Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left me-1"></i>Retour
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Ticket de caisse -->
    <div class="col-lg-8">
        <div class="card card-custom p-4 shadow-sm" id="printableTicket">
            <div class="text-center border-bottom pb-3 mb-3">
                <h4 class="brand-font fw-bold mb-1">L'Atelier Gourmand</h4>
                <p class="small text-muted mb-0">12 Avenue des Gastronomes, Paris • Tél: +33 1 42 68 00 00</p>
                <div class="mt-2">
                    <span class="badge bg-dark fs-6">@Model.Order.OrderNumber</span>
                </div>
            </div>

            <div class="row mb-3 small">
                <div class="col-6">
                    <div class="text-muted">Type : <strong class="text-dark">@Model.Order.OrderType</strong></div>
                    @if (Model.Order.RestaurantTable != null)
                    {
                        <div class="text-muted">Emplacement : <strong class="text-dark">Table @Model.Order.RestaurantTable.TableNumber (@Model.Order.RestaurantTable.Location)</strong></div>
                    }
                </div>
                <div class="col-6 text-end">
                    <div class="text-muted">Statut : <strong class="text-primary">@Model.Order.Status</strong></div>
                    @if (!string.IsNullOrEmpty(Model.Order.PaymentMethod))
                    {
                        <div class="text-muted">Paiement : <strong class="text-success">@Model.Order.PaymentMethod</strong></div>
                    }
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Order.Notes))
            {
                <div class="alert alert-light border small py-2 mb-3">
                    <strong>Instructions :</strong> @Model.Order.Notes
                </div>
            }

            <table class="table table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Plat</th>
                        <th class="text-center" style="width: 80px;">Qté</th>
                        <th class="text-end" style="width: 120px;">Prix Unit.</th>
                        <th class="text-end" style="width: 120px;">Sous-total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Order.OrderItems)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold">@item.MenuItem?.Name</div>
                                <small class="text-muted">@item.MenuItem?.Category?.Name</small>
                                @if (!string.IsNullOrEmpty(item.Notes))
                                {
                                    <div class="small text-danger">@item.Notes</div>
                                }
                            </td>
                            <td class="text-center fw-semibold">@item.Quantity</td>
                            <td class="text-end">@item.UnitPrice.ToString("C2")</td>
                            <td class="text-end fw-bold">@item.SubTotal.ToString("C2")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="3" class="text-end fw-bold fs-5">TOTAL À PAYER TTC :</td>
                        <td class="text-end fw-bold fs-5 text-success">@Model.Order.TotalAmount.ToString("C2")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <!-- Panneau d'actions & Règlement -->
    <div class="col-lg-4">
        <!-- Règlement / Paiement -->
        <div class="card card-custom p-4 mb-4">
            <h5 class="fw-bold mb-3"><i class="bi bi-credit-card me-2"></i>Règlement & Caisse</h5>
            @if (Model.Order.Status == OrderStatus.Payee)
            {
                <div class="alert alert-success border-0 text-center py-3">
                    <i class="bi bi-check-circle-fill fs-2 text-success mb-2 d-block"></i>
                    <strong>Commande Payée</strong>
                    <div class="small mt-1">Mode de règlement : @(Model.Order.PaymentMethod ?? "Validé")</div>
                </div>
            }
            else
            {
                <p class="small text-muted mb-3">Sélectionnez le mode de paiement pour clore la commande et libérer la table.</p>
                <form method="post" asp-page-handler="Pay" asp-route-id="@Model.Order.Id">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Mode de règlement :</label>
                        <select name="paymentMethod" class="form-select" required>
                            <option value="Carte Bancaire">Carte Bancaire</option>
                            <option value="Espèces">Espèces</option>
                            <option value="Titre Restaurant">Titre Restaurant / Chèque Déjeuner</option>
                            <option value="Sans Contact / Apple Pay">Sans Contact / Mobile</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-success w-100 py-2 fw-semibold">
                        <i class="bi bi-cash-coin me-1"></i>Encaisser @Model.Order.TotalAmount.ToString("C2")
                    </button>
                </form>
            }
        </div>

        <!-- Changement manuel du statut -->
        <div class="card card-custom p-4">
            <h5 class="fw-bold mb-3"><i class="bi bi-arrow-repeat me-2"></i>Changer le Statut</h5>
            <div class="d-grid gap-2">
                <form method="post" asp-page-handler="UpdateStatus" asp-route-id="@Model.Order.Id" asp-route-status="@OrderStatus.EnAttente">
                    <button type="submit" class="btn btn-outline-warning text-dark w-100 text-start @(Model.Order.Status == OrderStatus.EnAttente ? "active" : "")">
                        <i class="bi bi-hourglass-split me-2"></i>1. En Attente
                    </button>
                </form>
                <form method="post" asp-page-handler="UpdateStatus" asp-route-id="@Model.Order.Id" asp-route-status="@OrderStatus.EnPreparation">
                    <button type="submit" class="btn btn-outline-primary w-100 text-start @(Model.Order.Status == OrderStatus.EnPreparation ? "active" : "")">
                        <i class="bi bi-fire me-2"></i>2. En Cuisine / Préparation
                    </button>
                </form>
                <form method="post" asp-page-handler="UpdateStatus" asp-route-id="@Model.Order.Id" asp-route-status="@OrderStatus.Prete">
                    <button type="submit" class="btn btn-outline-info w-100 text-start @(Model.Order.Status == OrderStatus.Prete ? "active" : "")">
                        <i class="bi bi-bell-fill me-2"></i>3. Prête à servir
                    </button>
                </form>
                <form method="post" asp-page-handler="UpdateStatus" asp-route-id="@Model.Order.Id" asp-route-status="@OrderStatus.Servie">
                    <button type="submit" class="btn btn-outline-success w-100 text-start @(Model.Order.Status == OrderStatus.Servie ? "active" : "")">
                        <i class="bi bi-check-circle me-2"></i>4. Servie aux clients
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>


@page
@model restauration.Pages.Admin.Orders.CreateModel
@{
    ViewData["Title"] = "Prise de Commande";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="fw-bold mb-0"><i class="bi bi-cart-plus text-success me-2"></i>Prise de Commande (Caisse / Salle)</h2>
        <p class="text-muted small">Sélectionnez les plats et configurez la table ou la commande à emporter</p>
    </div>
    <a asp-page="./Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Retour aux commandes
    </a>
</div>

<form method="post" id="orderForm">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="row g-4">
        <!-- Partie Gauche : Sélection des plats par catégorie -->
        <div class="col-lg-7">
            <div class="card card-custom p-3 mb-3">
                <ul class="nav nav-pills mb-3" id="pills-tab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="pills-all-tab" data-bs-toggle="pill" data-bs-target="#pills-all" type="button" role="tab">
                            Tous
                        </button>
                    </li>
                    @foreach (var cat in Model.Categories)
                    {
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="pills-cat-@cat.Id-tab" data-bs-toggle="pill" data-bs-target="#pills-cat-@cat.Id" type="button" role="tab">
                                @cat.Name
                            </button>
                        </li>
                    }
                </ul>

                <div class="tab-content" id="pills-tabContent">
                    <!-- Onglet Tous -->
                    <div class="tab-pane fade show active" id="pills-all" role="tabpanel">
                        <div class="row g-2">
                            @for (int i = 0; i < Model.AvailableMenuItems.Count; i++)
                            {
                                var item = Model.AvailableMenuItems[i];
                                <div class="col-sm-6 col-md-4">
                                    <div class="card p-2 h-100 border text-center shadow-sm d-flex flex-column justify-content-between">
                                        <div>
                                            <div class="fw-bold text-truncate" title="@item.Name">@item.Name</div>
                                            <div class="text-warning fw-semibold">@item.Price.ToString("C2")</div>
                                            <small class="text-muted">@item.Category?.Name</small>
                                        </div>
                                        <div class="mt-2 pt-2 border-top d-flex justify-content-center align-items-center gap-2">
                                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="adjustQty(@item.Id, -1)">-</button>
                                            <span id="qty-badge-@item.Id" class="badge bg-light text-dark border px-2 py-1">0</span>
                                            <button type="button" class="btn btn-sm btn-outline-success" onclick="adjustQty(@item.Id, 1)">+</button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Onglets spécifiques -->
                    @foreach (var cat in Model.Categories)
                    {
                        var catItems = Model.AvailableMenuItems.Where(m => m.CategoryId == cat.Id).ToList();
                        <div class="tab-pane fade" id="pills-cat-@cat.Id" role="tabpanel">
                            <div class="row g-2">
                                @foreach (var item in catItems)
                                {
                                    <div class="col-sm-6 col-md-4">
                                        <div class="card p-2 h-100 border text-center shadow-sm d-flex flex-column justify-content-between">
                                            <div>
                                                <div class="fw-bold text-truncate" title="@item.Name">@item.Name</div>
                                                <div class="text-warning fw-semibold">@item.Price.ToString("C2")</div>
                                            </div>
                                            <div class="mt-2 pt-2 border-top d-flex justify-content-center align-items-center gap-2">
                                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="adjustQty(@item.Id, -1)">-</button>
                                                <span id="qty-badge-cat-@item.Id" class="badge bg-light text-dark border px-2 py-1">0</span>
                                                <button type="button" class="btn btn-sm btn-outline-success" onclick="adjustQty(@item.Id, 1)">+</button>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Partie Droite : Ticket de commande & Informations -->
        <div class="col-lg-5">
            <div class="card card-custom p-4 sticky-top" style="top: 20px;">
                <h5 class="fw-bold mb-3 border-bottom pb-2">
                    <i class="bi bi-receipt me-2"></i>Ticket de Caisse
                </h5>

                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <label asp-for="Order.OrderType" class="form-label fw-semibold small">Type de commande</label>
                        <select asp-for="Order.OrderType" class="form-select form-select-sm" id="orderTypeSelect" onchange="toggleTableSelect()">
                            <option value="@OrderType.SurPlace">Sur Place</option>
                            <option value="@OrderType.AEmporter">À Emporter</option>
                            <option value="@OrderType.Livraison">Livraison</option>
                        </select>
                    </div>

                    <div class="col-sm-6" id="tableSelectGroup">
                        <label asp-for="Order.RestaurantTableId" class="form-label fw-semibold small">Table</label>
                        <select asp-for="Order.RestaurantTableId" class="form-select form-select-sm">
                            <option value="">Sélectionner une table</option>
                            @foreach (var t in Model.Tables)
                            {
                                <option value="@t.Id">Table @t.TableNumber (@t.Location - @t.Capacity p.)</option>
                            }
                        </select>
                    </div>

                    <div class="col-sm-12">
                        <label asp-for="Order.CustomerName" class="form-label fw-semibold small">Nom du client / Référence</label>
                        <input asp-for="Order.CustomerName" class="form-control form-control-sm" placeholder="Optionnel (ou nom pour emporter)" />
                    </div>

                    <div class="col-sm-12">
                        <label asp-for="Order.Notes" class="form-label fw-semibold small">Instructions cuisine</label>
                        <input asp-for="Order.Notes" class="form-control form-control-sm" placeholder="ex: sans sel, cuisson à point..." />
                    </div>
                </div>

                <!-- Articles sélectionnés -->
                <div class="table-responsive my-2" style="max-height: 250px; overflow-y: auto;">
                    <table class="table table-sm align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Plat</th>
                                <th class="text-center">Qté</th>
                                <th class="text-end">Prix</th>
                            </tr>
                        </thead>
                        <tbody id="ticketItemsBody">
                            <tr id="emptyTicketRow">
                                <td colspan="3" class="text-center text-muted py-3 small">
                                    Aucun plat ajouté au ticket. Cliquez sur + sur les plats à gauche.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Total -->
                <div class="border-top pt-3 mt-2">
                    <div class="d-flex justify-content-between align-items-center fs-5 fw-bold mb-3">
                        <span>Total TTC :</span>
                        <span id="ticketTotalDisplay" class="text-success">0,00 €</span>
                    </div>

                    <!-- Champs cachés pour le formulaire POST -->
                    <div id="hiddenInputsContainer">
                        @for (int i = 0; i < Model.AvailableMenuItems.Count; i++)
                        {
                            var item = Model.AvailableMenuItems[i];
                            <input type="hidden" name="SelectedItemIds[@i]" value="@item.Id" />
                            <input type="hidden" name="ItemQuantities[@i]" id="input-qty-@item.Id" value="0" />
                        }
                    </div>

                    <button type="submit" class="btn btn-gold btn-lg w-100 shadow">
                        <i class="bi bi-check-circle me-1"></i>Valider & Envoyer en Cuisine
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const menuItemsData = {
            @foreach (var item in Model.AvailableMenuItems)
            {
                @:@item.Id: { name: "@item.Name", price: @item.Price.ToString(System.Globalization.CultureInfo.InvariantCulture) },
            }
        };

        const quantities = {};
        for (const id in menuItemsData) {
            quantities[id] = 0;
        }

        function adjustQty(itemId, delta) {
            const current = quantities[itemId] || 0;
            const updated = Math.max(0, current + delta);
            quantities[itemId] = updated;

            // Mettre à jour l'affichage sur la carte
            const badge = document.getElementById("qty-badge-" + itemId);
            if (badge) badge.innerText = updated;
            const catBadge = document.getElementById("qty-badge-cat-" + itemId);
            if (catBadge) catBadge.innerText = updated;

            // Mettre à jour l'input caché
            const input = document.getElementById("input-qty-" + itemId);
            if (input) input.value = updated;

            renderTicket();
        }

        function renderTicket() {
            const tbody = document.getElementById("ticketItemsBody");
            let total = 0;
            let rowsHtml = "";
            let hasItems = false;

            for (const id in quantities) {
                const qty = quantities[id];
                if (qty > 0) {
                    hasItems = true;
                    const item = menuItemsData[id];
                    const subtotal = qty * item.price;
                    total += subtotal;

                    rowsHtml += `<tr>
                        <td class="small fw-semibold">${item.name}</td>
                        <td class="text-center small">${qty}</td>
                        <td class="text-end small fw-bold">${subtotal.toFixed(2)} €</td>
                    </tr>`;
                }
            }

            if (!hasItems) {
                tbody.innerHTML = `<tr id="emptyTicketRow">
                    <td colspan="3" class="text-center text-muted py-3 small">
                        Aucun plat ajouté au ticket. Cliquez sur + sur les plats à gauche.
                    </td>
                </tr>`;
            } else {
                tbody.innerHTML = rowsHtml;
            }

            document.getElementById("ticketTotalDisplay").innerText = total.toFixed(2) + " €";
        }

        function toggleTableSelect() {
            const type = document.getElementById("orderTypeSelect").value;
            const tableGroup = document.getElementById("tableSelectGroup");
            if (type === "SurPlace" || type === "0") {
                tableGroup.style.display = "block";
            } else {
                tableGroup.style.display = "none";
            }
        }
    </script>
}


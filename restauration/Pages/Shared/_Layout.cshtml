<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - L'Atelier Gourmand</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom">
            <div class="container-fluid px-lg-4">
                <a class="navbar-brand brand-font d-flex align-items-center gap-2" asp-area="" asp-page="/Index">
                    <i class="bi bi-cup-hot-fill text-warning"></i>
                    <span>L'Atelier</span> Gourmand
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <!-- Liens Vitrine Client -->
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Index">
                                <i class="bi bi-house-door me-1"></i> Accueil
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Menu">
                                <i class="bi bi-journal-richtext me-1"></i> La Carte
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Reserver">
                                <i class="bi bi-calendar-check me-1"></i> Réserver une Table
                            </a>
                        </li>
                    </ul>

                    <!-- Liens Administration & Gestion -->
                    <ul class="navbar-nav ms-auto align-items-lg-center">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-speedometer2 me-1"></i>
                                <span>Gestion Restaurant</span>
                                <span class="admin-badge">Admin</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="adminDropdown">
                                <li>
                                    <a class="dropdown-item py-2" asp-page="/Admin/Index">
                                        <i class="bi bi-grid-1x2-fill text-primary me-2"></i> Tableau de bord
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-page="/Admin/Kitchen">
                                        <i class="bi bi-fire text-danger me-2"></i> Écran Cuisine en Direct (KDS)
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item py-2" asp-page="/Admin/Orders/Index">
                                        <i class="bi bi-receipt-cutoff text-success me-2"></i> Commandes & Caisse
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-page="/Admin/Tables/Index">
                                        <i class="bi bi-grid-3x3-gap-fill text-info me-2"></i> Plan des Tables
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-page="/Admin/Menu/Index">
                                        <i class="bi bi-egg-fried text-warning me-2"></i> Gestion des Plats
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-page="/Admin/Categories/Index">
                                        <i class="bi bi-tags-fill text-primary me-2"></i> Catégories du Menu
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-page="/Admin/Reservations/Index">
                                        <i class="bi bi-calendar-heart-fill text-danger me-2"></i> Gestion des Réservations
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-page="/Admin/Inventory/Index">
                                        <i class="bi bi-box-seam-fill text-secondary me-2"></i> Gestion des Stocks
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item py-2" asp-page="/Admin/Reports">
                                        <i class="bi bi-graph-up text-success me-2"></i> Statistiques & Rapports
                                    </a>
                                </li>
                            </ul>
                        </li>
                        <li class="nav-item ms-lg-2 mt-2 mt-lg-0">
                            <a class="btn btn-sm btn-gold d-flex align-items-center gap-1" asp-page="/Reserver">
                                <i class="bi bi-bookmark-plus"></i> Réserver
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-lg-4 py-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-custom">
        <div class="container-fluid px-lg-4">
            <div class="row g-4 mb-4">
                <div class="col-md-4">
                    <h5 class="brand-font text-white mb-3">
                        <i class="bi bi-cup-hot-fill text-warning me-2"></i>L'Atelier Gourmand
                    </h5>
                    <p class="small text-secondary">
                        Une cuisine raffinée alliant tradition culinaire et créativité moderne. Produits frais, locaux et de saison préparés avec passion chaque jour.
                    </p>
                </div>
                <div class="col-md-4">
                    <h6 class="text-white text-uppercase fw-bold mb-3">Horaires d'ouverture</h6>
                    <ul class="list-unstyled small text-secondary">
                        <li class="mb-1"><strong class="text-light">Lundi - Vendredi :</strong> 12h00 - 14h30 / 19h00 - 23h00</li>
                        <li class="mb-1"><strong class="text-light">Samedi - Dimanche :</strong> 12h00 - 15h00 / 19h00 - 23h30</li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6 class="text-white text-uppercase fw-bold mb-3">Contact & Réservations</h6>
                    <ul class="list-unstyled small text-secondary">
                        <li class="mb-1"><i class="bi bi-geo-alt text-warning me-2"></i> 12 Avenue des Gastronomes, Paris</li>
                        <li class="mb-1"><i class="bi bi-telephone text-warning me-2"></i> +33 1 42 68 00 00</li>
                        <li class="mb-1"><i class="bi bi-envelope text-warning me-2"></i> contact@ateliergourmand.fr</li>
                    </ul>
                </div>
            </div>
            <hr class="border-secondary my-3 opacity-25">
            <div class="d-flex flex-wrap justify-content-between align-items-center small text-secondary">
                <div>&copy; 2026 - L'Atelier Gourmand • Système de Gestion de Restaurant Intégré</div>
                <div class="d-flex gap-3">
                    <a asp-page="/Menu" class="text-secondary text-decoration-none">La Carte</a>
                    <a asp-page="/Reserver" class="text-secondary text-decoration-none">Réserver</a>
                    <a asp-page="/Admin/Index" class="text-secondary text-decoration-none">Espace Gestion</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>